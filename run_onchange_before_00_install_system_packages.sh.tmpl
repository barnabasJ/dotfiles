#!/bin/bash

set -e

{{ if or (eq .chezmoi.os "darwin") -}}


# install homebrew
/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

# install oh-my-zsh
if [ ! -d $ZSH ]; then
  sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
fi

# bitwarden cli
brew install bitwarden-cli

# ImageMagick — runtime dep for image.nvim's `magick` luarock
brew install imagemagick

{{ else if (and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu")) -}}

# Print the apt commands to run by hand — chezmoi shouldn't be invoking sudo.
# Each command is idempotent; re-running is safe. Only prints what's missing.

MISSING=""
dpkg -s imagemagick >/dev/null 2>&1 || MISSING="$MISSING imagemagick"
dpkg -s libmagickwand-dev >/dev/null 2>&1 || MISSING="$MISSING libmagickwand-dev"
if [ -n "$MISSING" ]; then
  echo
  echo "ACTION REQUIRED — install image.nvim runtime deps:"
  echo "  sudo apt install -y$MISSING"
  echo
fi

{{ else -}}
echo "Unsupported OS: {{ .chezmoi.os }}"
{{ end -}}

# install tmux plugin manager
if [ ! -d ~/.tmux/plugins/tpm ]; then
  git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
fi
