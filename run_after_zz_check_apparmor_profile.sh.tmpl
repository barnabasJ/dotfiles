#!/bin/bash
# Reminds you to install an AppArmor profile for puppeteer's bundled Chromium.
# Ubuntu 23.10+ restricts unprivileged user namespaces via AppArmor, which
# breaks Chromium's own sandbox when launched by puppeteer/mermaid-cli.
# Print only — sudo commands are yours to run.
{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") -}}

if [ ! -f /etc/apparmor.d/puppeteer-chrome ]; then
  cat <<'EOF'

================================================================
ACTION REQUIRED — install AppArmor profile for puppeteer/chromium
================================================================
Ubuntu 23.10+ blocks Chromium's sandbox via AppArmor userns
restrictions. Install this profile (one time):

sudo tee /etc/apparmor.d/puppeteer-chrome > /dev/null <<'PROFILE'
abi <abi/4.0>,
include <tunables/global>

profile puppeteer-chrome /home/*/.cache/puppeteer/chrome/linux-*/chrome-linux64/chrome flags=(unconfined) {
  userns,
  include if exists <local/puppeteer-chrome>
}

profile puppeteer-chrome-headless /home/*/.cache/puppeteer/chrome-headless-shell/linux-*/chrome-headless-shell-linux64/chrome-headless-shell flags=(unconfined) {
  userns,
  include if exists <local/puppeteer-chrome-headless>
}
PROFILE

sudo apparmor_parser -r /etc/apparmor.d/puppeteer-chrome

================================================================

EOF
fi

{{ end -}}
