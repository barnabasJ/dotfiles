#!/usr/bin/env bash
{{ if or (eq .chezmoi.os "darwin") (and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu")) -}}

set -e

if [ ! -f "$HOME/.local/bin/mise" ]; then
  echo "Installing mise..."
  if ! command -v curl &>/dev/null; then
    echo "Error: curl is required but not installed."
    exit 1
  fi
  curl -fsSL https://mise.run | sh
  echo "Successfully installed mise to ~/.local/bin/mise"
else
  echo "mise already installed"
fi
{{ else if eq .chezmoi.osRelease.id "nixos" -}}
# Nix provides the durable mise bootstrap on NixOS; chezmoi only owns the
# writable mise configuration generated by the later hook.
command -v mise >/dev/null 2>&1 || {
  echo "NixOS configuration must provide mise before chezmoi is applied." >&2
  exit 1
}
echo "Using the mise executable provided by NixOS."
{{ else -}}
echo "Unsupported OS: {{ .chezmoi.os }} ({{ .chezmoi.osRelease.id }})" >&2
exit 1
{{ end -}}
